# Copy to .env.local and fill in. The app works without a key
# (rule-based categorisation + fallback insights), but live AI
# insights need one of these.

# Recommended default: cheap + strong JSON adherence
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Alternatives (any OpenAI-compatible endpoint works):
# Groq (fast + free tier): LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=google/gemini-2.0-flash-001
# Gemini native OpenAI-compat: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
